    {
      "controlId": "NEG-010",
      "title": "User-visible TUI requirement lacks live evidence",
      "hardStops": [
        "missing_live_evidence",
        "user_visible_behavior_unverified"
      ],
      "policy": "user_visible_behavior_requires_live_evidence",
      "policyRationale": "P49 Tab/mode-picker is a user-visible TUI requirement. scripts/p0-tui-smoke.mjs launches the real TUI editor in a VirtualTerminal (backed by @xterm/headless), sends a real Tab keypress, and captures the screen. The live observation shows the screen does NOT contain the accp-mode-picker overlay: the picker module exists but is not wired to the editor's Tab handler. Promotion must be blocked because the user-visible behavior is contradicted by live evidence.",
      "harnessGap": false,
      "source": {
        "path": "reports/accp/gate-sanity/P0/source/NEG-010_live_ui_required_but_missing.accp.yaml",
        "sha256": "f69bb1aaba778d24ba73e7919f19a2837a8e774489a9132cf97f53f9bb774952"
      },
