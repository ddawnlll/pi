      "title": "Validation command returns no tests found",
      "hardStops": [
        "no_tests_found"
      ],
      "policy": "noTestsFoundIsFailure",
      "policyRationale": "vitest exits 1 with 'No test files found' for a targeted test pattern. Per planspec noTestsFoundIsFailure:true this is a blocking failure for targeted validation.",
