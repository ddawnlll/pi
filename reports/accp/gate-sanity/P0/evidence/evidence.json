      "title": "PRR tries to approve promotion while blockers exist",
      "hardStops": [
        "accp_prr_approved_with_blockers"
      ],
      "policy": "prr_approved_with_blockers_blocks_promotion",
      "policyRationale": "promotion_readiness.promotion_verdict:PROMOTE with promotion_readiness.blockers[].unresolved:true and severity:critical violates FinalPromotionGate. Promotion evaluator must reject.",
