    {
      "controlId": "NEG-006",
      "title": "Runtime attempts to use raw ACCP YAML or rendered Markdown as authority",
      "hardStops": [
        "missing_compiled_accp_artifact",
        "raw_yaml_is_not_runtime_authority"
      ],
      "policy": "compiled_json_is_runtime_input",
      "policyRationale": "ACCP_AUTHORITY doctrine says raw YAML and rendered Markdown are not runtime authority. A TVR/PRR that is not accompanied by compiled.json, gate-verdict.json, and route-signal.json cannot pass.",
      "harnessGap": false,
      "source": {
