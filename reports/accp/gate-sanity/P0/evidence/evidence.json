        "production_call_site_missing"
      ],
      "policy": "promotion_readiness_cannot_exceed_source_present_unproven",
      "policyRationale": "implementation_summary.production_call_sites is empty and implementation_summary.status:complete. Promotion readiness must cap at source_present_unproven / test_only; runtime_complete is unreachable.",
