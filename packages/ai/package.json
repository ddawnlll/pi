{
	"name": "@earendil-works/pi-ai",
	"version": "0.74.0",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./anthropic": {
			"types": "./dist/providers/anthropic.d.ts",
			"import": "./dist/providers/anthropic.js"
		},
		"./azure-openai-responses": {
			"types": "./dist/providers/azure-openai-responses.d.ts",
			"import": "./dist/providers/azure-openai-responses.js"
		},
		"./google": {
			"types": "./dist/providers/google.d.ts",
			"import": "./dist/providers/google.js"
		},
		"./google-vertex": {
			"types": "./dist/providers/google-vertex.d.ts",
			"import": "./dist/providers/google-vertex.js"
		},
		"./mistral": {
			"types": "./dist/providers/mistral.d.ts",
			"import": "./dist/providers/mistral.js"
		},
		"./openai-codex-responses": {
			"types": "./dist/providers/openai-codex-responses.d.ts",
			"import": "./dist/providers/openai-codex-responses.js"
		},
		"./openai-completions": {
			"types": "./dist/providers/openai-completions.d.ts",
			"import": "./dist/providers/openai-completions.js"
		},
		"./openai-responses": {
			"types": "./dist/providers/openai-responses.d.ts",
			"import": "./dist/providers/openai-responses.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		},
		"./bedrock-provider": {
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		}
	},
	"bin": {
		"pi-ai": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-models": "npx tsx scripts/generate-models.ts",
		"generate-image-models": "npx tsx scripts/generate-image-models.ts",
		"build": "npm run generate-models && npm run generate-image-models && tsgo -p tsconfig.build.json",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"dev:tsc": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"test:fast": "vitest run --exclude 'test/abort.test.ts' --exclude 'test/anthropic-eager-tool-input-e2e.test.ts' --exclude 'test/anthropic-long-cache-retention-e2e.test.ts' --exclude 'test/anthropic-opus-4-7-smoke.test.ts' --exclude 'test/anthropic-thinking-disable.test.ts' --exclude 'test/anthropic-tool-name-normalization.test.ts' --exclude 'test/cache-retention.test.ts' --exclude 'test/context-overflow.test.ts' --exclude 'test/cross-provider-handoff.test.ts' --exclude 'test/empty.test.ts' --exclude 'test/google-thinking-disable.test.ts' --exclude 'test/images.test.ts' --exclude 'test/image-tool-result.test.ts' --exclude 'test/interleaved-thinking.test.ts' --exclude 'test/openai-codex-cache-affinity-e2e.test.ts' --exclude 'test/openai-responses-cache-affinity-e2e.test.ts' --exclude 'test/openai-responses-reasoning-replay-e2e.test.ts' --exclude 'test/openai-responses-tool-result-images.test.ts' --exclude 'test/openrouter-cache-write-repro.test.ts' --exclude 'test/overflow.test.ts' --exclude 'test/responseid.test.ts' --exclude 'test/stream.test.ts' --exclude 'test/tokens.test.ts' --exclude 'test/tool-call-id-normalization.test.ts' --exclude 'test/tool-call-without-result.test.ts' --exclude 'test/total-tokens.test.ts' --exclude 'test/unicode-surrogate.test.ts' --exclude 'test/xhigh.test.ts' --exclude 'test/zen.test.ts'",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.91.1",
		"@aws-sdk/client-bedrock-runtime": "^3.1030.0",
		"@google/genai": "^1.40.0",
		"@mistralai/mistralai": "^2.2.0",
		"typebox": "^1.1.24",
		"chalk": "^5.6.2",
		"openai": "6.26.0",
		"partial-json": "^0.1.7",
		"proxy-agent": "^6.5.0",
		"undici": "^7.19.1",
		"zod-to-json-schema": "^3.24.6"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi-mono.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"canvas": "^3.2.0",
		"vitest": "^3.2.4"
	}
}
